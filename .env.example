# Copia este archivo como  .env  y pon tus valores reales.
# El archivo .env NUNCA se sube a Git (ya está en .gitignore).
#
# En el servidor:   cp .env.example .env  &&  nano .env
# Permisos:         chmod 600 .env

# ---------------------------------------------------------------------
#  Base de datos
# ---------------------------------------------------------------------
# SQLite: un solo archivo, sin servicio que instalar. Si no lo defines,
# se guarda en  datos/konekt.db  dentro del proyecto.
# DB_RUTA=D:\konekt\konekt.db

# Respaldos: cuantos conservar y donde. Ver  npm run respaldar
RESPALDOS_CONSERVAR=30
# RESPALDOS_RUTA=D:\respaldos-konekt

# ---------------------------------------------------------------------
#  Acceso
# ---------------------------------------------------------------------
# SIN_LOGIN=1  ->  se entra sin contrasena. Todos comparten la misma cartera
#                  y cualquiera que alcance este puerto puede ver y borrar.
#                  Pensado para una red interna cerrada.
#
# Para volver a pedir contrasena: comenta esta linea, reinicia y da de alta
# usuarios con  npm run usuario -- crear tu@correo.mx "Tu Nombre" admin
# Lo capturado hasta entonces queda a nombre del usuario local; no se pierde.
SIN_LOGIN=1

# Nombre que aparece como vendedor cuando no hay login.
USUARIO_NOMBRE=Konekt

# ---------------------------------------------------------------------
#  Anthropic  (obligatorio para los botones de IA del generador)
# ---------------------------------------------------------------------
# Se obtiene en https://console.anthropic.com
# Vive SOLO aquí, en el servidor. Nunca llega al navegador.
ANTHROPIC_API_KEY=sk-ant-...

# Modelo a usar. Opciones:
#   claude-sonnet-5   equilibrio calidad/costo/velocidad  (por defecto)
#   claude-opus-5     el más capaz, mejor redacción, más caro
#   claude-haiku-4-5  el más rápido y barato, suficiente para extraer datos
KONEKT_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------
#  Servidor
# ---------------------------------------------------------------------
PORT=3000

# Interfaz donde escucha.
#   0.0.0.0    dentro de Docker, o si nginx está en otra máquina  (por defecto)
#   127.0.0.1  con nginx en la misma máquina: así el puerto 3000 no queda
#              expuesto a internet, solo accesible desde el propio servidor
HOST=0.0.0.0

# Ponlo en "production" al desplegar. Activa HSTS y deja de mostrarle al
# usuario los detalles internos de los errores.
NODE_ENV=production

# Número de proxies enfrente. Con nginx o Caddy en la misma máquina: 1.
# Sin proxy, déjalo vacío o comentado.
# Si no lo configuras teniendo un proxy, el límite de uso ve la IP del proxy
# en vez de la del usuario y estrangula a todo el equipo junto.
TRUST_PROXY=1

# Peticiones a la IA por usuario cada 5 minutos.
MAX_PETICIONES=40
