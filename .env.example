# Copia este archivo como  .env  y pon tus valores reales.
# El archivo .env NUNCA se sube a Git (ya está en .gitignore).

# Llave de la API de Anthropic. Se obtiene en https://console.anthropic.com
# Vive SOLO aquí, en el servidor. Nunca en el HTML ni en el navegador.
ANTHROPIC_API_KEY=sk-ant-...

# Modelo a usar. Opciones:
#   claude-sonnet-5   equilibrio calidad/costo/velocidad  (por defecto)
#   claude-opus-5     el más capaz, mejor redacción, más caro
#   claude-haiku-4-5  el más rápido y barato, suficiente para extraer datos
KONEKT_MODEL=claude-sonnet-5

# Puerto local del servidor
PORT=3000
